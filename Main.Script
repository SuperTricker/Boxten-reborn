-- BUTTON: Rainbow Character (fun)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Button({
    Name = "Rainbow Character",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            task.spawn(function()
                local t = 0
                for _ = 1, 60 do
                    t = t + 0.05
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.Color = Color3.fromHSV((t + p.Position.Y * 0.1) % 1, 0.8, 1)
                        end
                    end
                    task.wait(0.05)
                end
            end)
        end)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Spin Character
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Button({
    Name = "Spin Character",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
