-- [14] EXTENDED UTILITIES — Advanced ESP Add-ons
--=============================================================================

--─────────────────────────────────────────────────────────────────────────────
-- TOGGLE: Monster Tracers
--─────────────────────────────────────────────────────────────────────────────
local MonsterTracerFolder = Instance.new("Folder")
MonsterTracerFolder.Name = "BoxtenMonsterTracers"
MonsterTracerFolder.Parent = PlayerGui

MonsterSection:Toggle({
    Name = "Monster Tracers",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("MonsterTracers")
            Tracked.Connections["MonsterTracers"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    if not cam then return end
                    local room = getCurrentRoom()
                    if not room then return end

                    local seen = {}
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp then
                                    seen[d.Name] = true
                                    local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                                    if onScreen then
                                        local tracer = MonsterTracerFolder:FindFirstChild(d.Name .. "_tracer")
                                        if not tracer then
                                            tracer = Instance.new("Frame")
                                            tracer.Name = d.Name .. "_tracer"
                                            tracer.BackgroundColor3 = Color3.fromRGB(168, 200, 150)
                                            tracer.BorderSizePixel = 0
                                            tracer.Size = UDim2.new(0, 2, 0, 0)
                                            tracer.Parent = MonsterTracerFolder
                                        end
                                        tracer.Position = UDim2.new(0, screenPos.X, 0, 0)
                                        tracer.Size = UDim2.new(0, 2, 0, screenPos.Y)
                                    end
                                end
                            end
                        end
                    end

                    for _, c in ipairs(MonsterTracerFolder:GetChildren()) do
                        local name = c.Name:gsub("_tracer", "")
                        if not seen[name] then
                            c:Destroy()
                        end
                    end
                end)
            end)
        else
            safeDisconnect("MonsterTracers")
            for _, c in ipairs(MonsterTracerFolder:GetChildren()) do
                pcall(function() c:Destroy() end)
            end
        end
    end
})

--─────────────────────────────────────────────────────────────────────────────
-- TOGGLE: Monster Distance ESP
--─────────────────────────────────────────────────────────────────────────────
MonsterSection:Toggle({
    Name = "Monster Distance ESP",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("MonsterDist")
            Tracked.Connections["MonsterDist"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end

                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local head = getHead(d)
                                local hrp = d:FindFirstChild("HumanoidRootPart") or head
                                if head and hrp then
                                    local dist = (hrp.Position - myHRP.Position).Magnitude
                                    local bg = head:FindFirstChild("BoxtenMonsterDist_BG")
                                    if not bg then
                                        bg = makeBillboard(head, "BoxtenMonsterDist_BG",
                                            UDim2.new(0, 140, 0, 24),
                                            Vector3.new(0, 3.4, 0),
                                            Color3.fromRGB(255, 100, 100))
                                    end
                                    local lbl = bg:FindFirstChild("Label")
                                    if lbl then
                                        lbl.Text = math.floor(dist) .. " studs"
                                    end
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("MonsterDist")
            destroyBillboards("BoxtenMonsterDist_BG")
        end
    end
})

--─────────────────────────────────────────────────────────────────────────────
-- TOGGLE: Show Monster Names
--─────────────────────────────────────────────────────────────────────────────
MonsterSection:Toggle({
    Name = "Show Monster Names",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("MonsterNames")
            Tracked.Connections["MonsterNames"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local head = getHead(d)
                                if head and not head:FindFirstChild("BoxtenMonsterName_BG") then
                                    local bg = makeBillboard(head, "BoxtenMonsterName_BG",
                                        UDim2.new(0, 140, 0, 26),
                                        Vector3.new(0, 4.2, 0),
                                        Color3.fromRGB(168, 200, 150))
                                    local lbl = bg:FindFirstChild("Label")
                                    if lbl then lbl.Text = d.Name end
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("MonsterNames")
            destroyBillboards("BoxtenMonsterName_BG")
        end
    end
})

--─────────────────────────────────────────────────────────────────────────────
-- TOGGLE: Box ESP (corner brackets)
--─────────────────────────────────────────────────────────────────────────────
local BoxGui = Instance.new("ScreenGui")
BoxGui.Name = "BoxtenBoxESP"
BoxGui.ResetOnSpawn = false
BoxGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
BoxGui.Parent = PlayerGui

local BoxFolder = Instance.new("Folder")
BoxFolder.Name = "Boxes"
BoxFolder.Parent = BoxGui

MonsterSection:Toggle({
    Name = "Box ESP",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("BoxESP")
            Tracked.Connections["BoxESP"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    if not cam then return end
                    local room = getCurrentRoom()
                    if not room then return end

                    local seen = {}
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp then
                                    seen[d.Name] = true
                                    local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                                    if onScreen then
                                        local box = BoxFolder:FindFirstChild(d.Name .. "_box")
                                        if not box then
                                            box = Instance.new("Frame")
                                            box.Name = d.Name .. "_box"
                                            box.BackgroundTransparency = 1
                                            box.BorderSizePixel = 0
                                            box.Parent = BoxFolder
                                            for _, side in ipairs({"Top","Bottom","Left","Right"}) do
                                                local line = Instance.new("Frame")
                                                line.Name = side
                                                line.BackgroundColor3 = Color3.fromRGB(168, 200, 150)
                                                line.BorderSizePixel = 0
                                                line.Parent = box
                                            end
                                        end
                                        local size = 60
                                        box.Size = UDim2.new(0, size, 0, size * 1.5)
                                        box.Position = UDim2.new(0, pos.X - size/2, 0, pos.Y - size*0.75)
                                        box.Top.Size = UDim2.new(1, 0, 0, 2)
                                        box.Top.Position = UDim2.new(0, 0, 0, 0)
                                        box.Bottom.Size = UDim2.new(1, 0, 0, 2)
                                        box.Bottom.Position = UDim2.new(0, 0, 1, -2)
                                        box.Left.Size = UDim2.new(0, 2, 1, 0)
                                        box.Left.Position = UDim2.new(0, 0, 0, 0)
                                        box.Right.Size = UDim2.new(0, 2, 1, 0)
                                        box.Right.Position = UDim2.new(1, -2, 0, 0)
                                    end
                                end
                            end
                        end
                    end

                    for _, c in ipairs(BoxFolder:GetChildren()) do
                        local name = c.Name:gsub("_box", "")
                        if not seen[name] then c:Destroy() end
                    end
                end)
            end)
        else
            safeDisconnect("BoxESP")
            for _, c in ipairs(BoxFolder:GetChildren()) do
                pcall(function() c:Destroy() end)
            end
        end
    end
})

--─────────────────────────────────────────────────────────────────────────────
-- TOGGLE: Danger Indicator (screen border red when monster near)
--─────────────────────────────────────────────────────────────────────────────
local DangerGui = Instance.new("ScreenGui")
DangerGui.Name = "BoxtenDanger"
DangerGui.ResetOnSpawn = false
DangerGui.IgnoreGuiInset = true
DangerGui.Parent = PlayerGui

local DangerBorder = Instance.new("Frame")
DangerBorder.Name = "Border"
DangerBorder.Size = UDim2.new(1, 0, 1, 0)
DangerBorder.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
DangerBorder.BackgroundTransparency = 1
DangerBorder.BorderSizePixel = 0
DangerBorder.Parent = DangerGui

local dangerStroke = Instance.new("UIStroke")
dangerStroke.Thickness = 20
dangerStroke.Color = Color3.fromRGB(255, 0, 0)
dangerStroke.Transparency = 1
dangerStroke.Parent = DangerBorder

MonsterSection:Toggle({
    Name = "Danger Indicator",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("Danger")
            Tracked.Connections["Danger"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end

                    local nearestDist = math.huge
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp then
                                    local dist = (hrp.Position - myHRP.Position).Magnitude
                                    if dist < nearestDist then nearestDist = dist end
                                end
                            end
                        end
                    end

                    if nearestDist < 30 then
                        dangerStroke.Transparency = 0.2
                    elseif nearestDist < 60 then
                        dangerStroke.Transparency = 0.6
                    else
                        dangerStroke.Transparency = 1
                    end
                end)
            end)
        else
            safeDisconnect("Danger")
            dangerStroke.Transparency = 1
        end
    end
})

--=============================================================================
-- [15] SELF-HEALING HOOKS
--=============================================================================
task.spawn(function()
    while true do
        task.wait(5)
        pcall(function()
            -- Re-apply WalkSpeed if lost
            if State.LoopSpeed and State.LoopSpeed ~= 16 then
                local hum = getHumanoid()
                if hum and hum.WalkSpeed ~= State.LoopSpeed then
                    hum.WalkSpeed = State.LoopSpeed
                end
            end
            -- Re-apply JumpPower
            if State.JumpPower and State.JumpPower ~= 50 then
                local hum = getHumanoid()
                if hum and hum.JumpPower ~= State.JumpPower then
                    hum.UseJumpPower = true
                    hum.JumpPower = State.JumpPower
                end
            end
            -- Verify connections alive
            for key, conn in pairs(Tracked.Connections) do
                if not conn or not conn.Connected then
                    Tracked.Connections[key] = nil
                end
            end
        end)
    end
end)

--=============================================================================
-- [16] FPS BOOST / PERFORMANCE
--=============================================================================
MiscPage:Section({Name = "Performance", Side = 2}):Toggle({
    Name = "FPS Boost",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("FPSBoost")
            Tracked.Connections["FPSBoost"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    for _, d in ipairs(Workspace:GetDescendants()) do
                        if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke")
                        or d:IsA("Fire") or d:IsA("Sparkles") then
                            if d.Enabled then
                                d.Enabled = false
                                d:SetAttribute("BoxtenFPSBoost", true)
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("FPSBoost")
            pcall(function()
                for _, d in ipairs(Workspace:GetDescendants()) do
                    if d:GetAttribute("BoxtenFPSBoost") then
                        d.Enabled = true
                        d:SetAttribute("BoxtenFPSBoost", nil)
                    end
                end
            end)
        end
    end
})

--=============================================================================
-- [17] QUICK ACTION BUTTONS
--=============================================================================
local QuickSection = MiscPage:Section({Name = "Quick Actions", Side = 1})

QuickSection:Button({
    Name = "Reset Character",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
        end)
    end
})

QuickSection:Button({
    Name = "Reload Script",
    Callback = function()
        pcall(function()
            for _, v in pairs(PlayerGui:GetChildren()) do
                if v.Name:find("Boxten") or v.Name:find("Noxious") then
                    v:Destroy()
                end
            end
        end)
        notify("Reload", "Close and re-execute script")
    end
})

QuickSection:Button({
    Name = "Copy JobId",
    Callback = function()
        pcall(function()
            if setclipboard then
                setclipboard(game.JobId)
                notify("Copied", "JobId: " .. string.sub(game.JobId, 1, 12) .. "...")
            else
                notify("Copy", "No setclipboard")
            end
        end)
    end
})

QuickSection:Button({
    Name = "Copy PlaceId",
    Callback = function()
        pcall(function()
            if setclipboard then
                setclipboard(tostring(game.PlaceId))
                notify("Copied", "PlaceId: " .. tostring(game.PlaceId))
            end
        end)
    end
})

QuickSection:Button({
    Name = "Show Server Info",
    Callback = function()
        pcall(function()
            local info = "JobId: " .. game.JobId ..
                "\nPlace: " .. game.PlaceId ..
                "\nPlayers: " .. #Players:GetPlayers() ..
                "\nPing: " .. math.floor(LocalPlayer:GetNetworkPing() * 1000) .. "ms"
            notify("Server Info", info)
        end)
    end
})

--=============================================================================
-- [18] FINAL RESPAWN RE-APPLICATION
--=============================================================================
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = State.LoopSpeed
            hum.UseJumpPower = true
            hum.JumpPower = State.JumpPower
        end
    end)
    -- Reapply self ESP
    pcall(function()
        if char:FindFirstChild("BoxtenSelfESP") then
            -- already exists
        end
    end)
end)

--=============================================================================
-- [19] SHUTDOWN HOOK (crash safe)
--=============================================================================
LocalPlayer.OnTeleport:Connect(function(state)
    pcall(function()
        if state == Enum.TeleportState.Started then
            safeDisconnectAll()
            for _, h in pairs(Tracked.Highlights) do
                pcall(function() h:Destroy() end)
            end
            for b in pairs(Tracked.Billboards) do
                pcall(function() b:Destroy() end)
            end
        end
    end)
end)

--=============================================================================
-- [20] STATUS CONFIRMATION
--=============================================================================
notify("Boxten Reborn [ULTIMATE]", "Loaded | " .. #Players:GetPlayers() .. " players")

--=============================================================================
-- [21] FINAL: Window Init (already called in Part 4 for safety)
--=============================================================================
pcall(function()
    Window:Init()
end)

