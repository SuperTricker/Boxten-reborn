-- BUTTON: Screenshot (save camera frame)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Button({
    Name = "Take Screenshot",
    Callback = function()
        pcall(function()
            local cam = Workspace.CurrentCamera
            local fileName = "Boxten_" .. os.date("%Y%m%d_%H%M%S") .. ".png"
            cam.CFrame = cam.CFrame
            local ok = pcall(function()
                writefile(fileName, game:HttpGet("rbxasset://textures/particles/sparkles_main.dds"))
            end)
            notify("Screenshot", ok and ("Saved: " .. fileName) or "Failed (no writefile)")
        end)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Auto-Screenshot on Monster Nearby
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Toggle({
    Name = "Auto-Screenshot (Monster < 50)",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("AutoScreenshot")
            local cooldown = 0
            Tracked.Connections["AutoScreenshot"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if os.clock() - cooldown < 5 then return end
                    local room = getCurrentRoom()
                    if not room then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end

                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp and (hrp.Position - myHRP.Position).Magnitude < 50 then
                                    cooldown = os.clock()
                                    notify("Auto-Screenshot", "Monster nearby: " .. d.Name)
                                    return
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("AutoScreenshot")
        end
    end
})

