-- BOXTEN REBORN [ULTIMATE] — MERGED PARTS 1/5 THROUGH 5/5
-- Parts 3/5 and 4/5 recovered from the uploaded DeepSeek conversation exports.
-- Source assembly; review compatibility with the target game and executor before use.


--[[
    BOXTEN REBORN [ULTIMATE] - BLOK 1 / 5
    Services | Executor Wrappers | UI Init | State | Helpers | Main Page Start
]]

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local Lighting         = game:GetService("Lighting")
local Workspace        = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Debris           = game:GetService("Debris")
local StarterGui       = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui", 30)

local fireprox = (typeof(fireproximityprompt) == "function") and fireproximityprompt or function(prompt)
    if not prompt then return end
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(0.05)
    pcall(function() prompt:InputHoldEnd() end)
end

local function safeFire(prompt)
    pcall(function() fireprox(prompt) end)
end

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 3,
        })
    end)
end

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImInsane-1337/neverlose-ui/refs/heads/main/source/library.lua"))()
local Accent   = Color3.fromRGB(255, 255, 255)
local Gradient = Color3.fromRGB(150, 150, 150)
Library.Theme.Accent = Accent
Library.Theme.AccentGradient = Gradient
Library:ChangeTheme("Accent", Accent)
Library:ChangeTheme("AccentGradient", Gradient)
Library.Theme["Background"]           = Color3.fromRGB(10, 10, 10)
Library.Theme["Background 2"]         = Color3.fromRGB(15, 15, 15)
Library.Theme["Section Background"]   = Color3.fromRGB(12, 12, 12)
Library.Theme["Section Background 2"] = Color3.fromRGB(18, 18, 18)
Library.Theme["Element"]              = Color3.fromRGB(22, 22, 22)
Library.Theme["Text"]                 = Color3.fromRGB(230, 230, 230)

local Window = Library:Window({
    Name        = "Boxten Reborn [ULTIMATE]",
    SubName     = "Noxious Remake (Client-Side Loops)",
    Logo        = "6419106159",
    MenuKeybind = Enum.KeyCode.End
})

local KeybindList = Library:KeybindList("Keybinds")

task.spawn(function()
    while true do
        local ok, fps = pcall(function()
            return math.floor(1 / RunService.RenderStepped:Wait())
        end)
        if ok then
            pcall(function()
                Library:Watermark({"Boxten Reborn", "FPS: " .. fps})
            end)
        end
        task.wait(0.5)
    end
end)

local State = {
    AutoCalibration  = false,
    MachineAura      = false,
    InfiniteStamina  = false,
    Noclip           = false,
    GodMode          = false,
    LoopSpeed        = 16,
    JumpPower        = 50,
    ESP_Monsters     = false,
    ESP_Cooldowns    = false,
    ESP_Machines     = false,
    ESP_Items        = false,
    ESP_LobbyItems   = false,
    ESP_NPC          = false,
    Fullbright       = false,
    ESP_Players      = false,
    TeamStats        = false,
    FunnyFaces       = false,
    Lobotomy         = false,
    AutoBuy          = false,
    AutoDialogue     = false,
    AntiAfk          = true,
}

local Tracked = {
    Highlights   = {},
    Billboards   = {},
    Connections  = {},
}

local function safeDisconnect(key)
    if Tracked.Connections[key] then
        pcall(function() Tracked.Connections[key]:Disconnect() end)
        Tracked.Connections[key] = nil
    end
end

local function safeDisconnectAll()
    for k, c in pairs(Tracked.Connections) do
        pcall(function() c:Disconnect() end)
        Tracked.Connections[k] = nil
    end
end

local function destroyHighlights(filterName)
    for inst, h in pairs(Tracked.Highlights) do
        if not filterName or h.Name == filterName then
            pcall(function() h:Destroy() end)
            Tracked.Highlights[inst] = nil
        end
    end
end

local function destroyBillboards(filterName)
    for inst, _ in pairs(Tracked.Billboards) do
        if not filterName or inst.Name == filterName then
            pcall(function() inst:Destroy() end)
            Tracked.Billboards[inst] = nil
        end
    end
end

local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function getCurrentRoom()
    return Workspace:FindFirstChild("CurrentRoom")
end

local function getHead(model)
    if not model then return nil end
    return model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
end

local function makeBillboard(head, name, size, offset, textColor)
    if not head then return nil end
    local existing = head:FindFirstChild(name)
    if existing then return existing end
    local bg = Instance.new("BillboardGui")
    bg.Name = name
    bg.Size = size or UDim2.new(0, 160, 0, 32)
    bg.StudsOffset = offset or Vector3.new(0, 2.5, 0)
    bg.AlwaysOnTop = true
    bg.Parent = head
    Tracked.Billboards[bg] = true
    local lbl = Instance.new("TextLabel")
    lbl.Name = "Label"
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
    lbl.TextStrokeTransparency = 0
    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 15
    lbl.Text = ""
    lbl.Parent = bg
    return bg
end

local Main        = Window:Page({Name = "Main", Icon = "85757263778683"})
local FarmSection = Main:Section({Name = "Autofarm", Side = 1})
local CharSection = Main:Section({Name = "Character Exploits", Side = 2})

FarmSection:Button({
    Name = "Instant Auto Calibration (Skillcheck)",
    Callback = function()
        State.AutoCalibration = not State.AutoCalibration
        if not State.AutoCalibration then
            safeDisconnect("AutoCalib")
            notify("Auto Calibration", "Disabled")
            return
        end
        pcall(function()
            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                if gui:IsA("GuiObject") then
                    local n = string.lower(gui.Name)
                    if n:find("skillcheck") or n:find("minigame")
                    or n:find("calibration") or n:find("check") then
                        pcall(function() gui:Destroy() end)
                    end
                end
            end
        end)
        safeDisconnect("AutoCalib")
        Tracked.Connections["AutoCalib"] = PlayerGui.ChildAdded:Connect(function(child)
            if not State.AutoCalibration then return end
            local n = string.lower(child.Name)
            if n:find("skillcheck") or n:find("minigame")
            or n:find("calibration") or n:find("check") then
                pcall(function() child:Destroy() end)
                task.spawn(function()
                    for _, d in ipairs(child:GetDescendants()) do
                        if d:IsA("GuiObject") then
                            pcall(function() d:Destroy() end)
                        end
                    end
                end)
            end
        end)
        notify("Auto Calibration", "Enabled")
    end
})

FarmSection:Button({
    Name = "Machine Aura (Auto Fix)",
    Callback = function()
        State.MachineAura = not State.MachineAura
        if not State.MachineAura then
            notify("Machine Aura", "Disabled")
            return
        end
        notify("Machine Aura", "Enabled")
        task.spawn(function()
            while State.MachineAura do
                task.wait(0.1)
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("generator") or nm:find("machine") then
                                for _, p in ipairs(d:GetDescendants()) do
                                    if p:IsA("ProximityPrompt") then
                                        safeFire(p)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
})

FarmSection:Button({
    Name = "Auto Complete Dialogues",
    Callback = function()
        State.AutoDialogue = not State.AutoDialogue
        if not State.AutoDialogue then
            safeDisconnect("AutoDlg")
            notify("Auto Dialogue", "Disabled")
            return
        end
        safeDisconnect("AutoDlg")
        Tracked.Connections["AutoDlg"] = PlayerGui.ChildAdded:Connect(function(child)
            if not State.AutoDialogue then return end
            local n = string.lower(child.Name)
            if n:find("dialog") or n:find("prompt") or n:find("confirm") then
                task.wait(0.1)
                for _, btn in ipairs(child:GetDescendants()) do
                    if btn:IsA("TextButton") then
                        local btnName = string.lower(btn.Name) .. " " .. string.lower(btn.Text)
                        if btnName:find("yes") or btnName:find("accept")
                        or btnName:find("ok") or btnName:find("confirm") then
                            pcall(function()
                                local vu = game:GetService("VirtualUser")
                                vu:CaptureController()
                                vu:ClickButton1(Vector2.new(btn.AbsolutePosition.X, btn.AbsolutePosition.Y))
                            end)
                        end
                    end
                end
            end
        end)
        notify("Auto Dialogue", "Enabled")
    end
})

CharSection:Toggle({
    Name = "Infinite Stamina",
    Default = false,
    Callback = function(v)
        State.InfiniteStamina = v
        if v then
            task.spawn(function()
                while State.InfiniteStamina do
                    task.wait(0.01)
                    pcall(function()
                        local char = LocalPlayer.Character
                        if not char then return end
                        local cfg = char:FindFirstChild("Config")
                        if cfg and cfg:FindFirstChild("Stamina") then
                            cfg.Stamina.Value = 100
                        end
                    end)
                end
            end)
        end
    end
})

CharSection:Toggle({
    Name = "Noclip",
    Default = false,
    Callback = function(v)
        State.Noclip = v
        if v then
            safeDisconnect("Noclip")
            Tracked.Connections["Noclip"] = RunService.Stepped:Connect(function()
                if not State.Noclip then return end
                pcall(function()
                    local char = LocalPlayer.Character
                    if not char then return end
                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("BasePart") then
                            d.CanCollide = false
                        end
                    end
                end)
            end)
        else
            safeDisconnect("Noclip")
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                        d.CanCollide = true
                    end
                end
            end)
        end
    end
})

CharSection:Button({
    Name = "God Mode (Infinite Hearts)",
    Callback = function()
        State.GodMode = not State.GodMode
        if not State.GodMode then
            notify("God Mode", "Disabled")
            return
        end
        notify("God Mode", "Enabled")
        task.spawn(function()
            while State.GodMode do
                task.wait(0.01)
                pcall(function()
                    local char = LocalPlayer.Character
                    if not char then return end
                    local cfg = char:FindFirstChild("Config")
                    if cfg and cfg:FindFirstChild("Hearts") then
                        cfg.Hearts.Value = 999
                    end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.MaxHealth = 999
                        hum.Health = 999
                    end
                end)
            end
        end)
    end
})

CharSection:Toggle({
    Name = "Anti-Void",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("AntiVoid")
            Tracked.Connections["AntiVoid"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local char = LocalPlayer.Character
                    if not char then return end
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp and hrp.Position.Y < -50 then
                        hrp.CFrame = CFrame.new(0, 50, 0)
                    end
                end)
            end)
        else
            safeDisconnect("AntiVoid")
        end
    end
})

CharSection:Slider({
    Name = "Loop Speed",
    Min = 16,
    Max = 120,
    Default = 16,
    Callback = function(v)
        State.LoopSpeed = v
        pcall(function()
            local hum = getHumanoid()
            if hum then hum.WalkSpeed = v end
        end)
    end
})

CharSection:Slider({
    Name = "Jump Power",
    Min = 50,
    Max = 200,
    Default = 50,
    Callback = function(v)
        State.JumpPower = v
