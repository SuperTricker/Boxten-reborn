--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
local FrozenCamCFrame = nil
FunSection:Toggle({
    Name = "Freeze Camera",
    Default = false,
    Callback = function(v)
        local cam = Workspace.CurrentCamera
        if v then
            FrozenCamCFrame = cam.CFrame
            safeDisconnect("FreezeCam")
            Tracked.Connections["FreezeCam"] = RunService.RenderStepped:Connect(function()
                pcall(function()
                    if FrozenCamCFrame then
                        cam.CFrame = FrozenCamCFrame
                    end
                end)
            end)
        else
            safeDisconnect("FreezeCam")
            FrozenCamCFrame = nil
        end
    end
})

