local FullbrightBackup = nil
MapSection:Toggle({
    Name = "Alternative Fullbright",
    Default = false,
    Callback = function(v)
        State.Fullbright = v
        if v then
            if not FullbrightBackup then
                FullbrightBackup = {
                    Ambient        = Lighting.Ambient,
                    OutdoorAmbient = Lighting.OutdoorAmbient,
                    FogEnd         = Lighting.FogEnd,
                    FogStart       = Lighting.FogStart,
                    GlobalShadows  = Lighting.GlobalShadows,
                    Brightness     = Lighting.Brightness,
                    ClockTime      = Lighting.ClockTime,
                    EnvironmentDiffuseScale  = Lighting.EnvironmentDiffuseScale,
                    EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
                }
            end
            pcall(function()
                Lighting.Ambient        = Color3.fromRGB(255, 255, 255)
                Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
                Lighting.FogEnd         = 999999
                Lighting.FogStart       = 0
                Lighting.GlobalShadows  = false
                Lighting.Brightness     = 2
                Lighting.ClockTime      = 12
                Lighting.EnvironmentDiffuseScale  = 1
                Lighting.EnvironmentSpecularScale = 1
            end)
        else
            if FullbrightBackup then
                pcall(function()
                    Lighting.Ambient        = FullbrightBackup.Ambient
                    Lighting.OutdoorAmbient = FullbrightBackup.OutdoorAmbient
                    Lighting.FogEnd         = FullbrightBackup.FogEnd
                    Lighting.FogStart       = FullbrightBackup.FogStart
                    Lighting.GlobalShadows  = FullbrightBackup.GlobalShadows
                    Lighting.Brightness     = FullbrightBackup.Brightness
                    Lighting.ClockTime      = FullbrightBackup.ClockTime
                    Lighting.EnvironmentDiffuseScale  = FullbrightBackup.EnvironmentDiffuseScale
                    Lighting.EnvironmentSpecularScale = FullbrightBackup.EnvironmentSpecularScale
                end)
                FullbrightBackup = nil
            end
        end
    end
})

MapSection:Toggle({
    Name = "Remove Fog",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("NoFog")
            Tracked.Connections["NoFog"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    for _, child in ipairs(Lighting:GetChildren()) do
                        if child:IsA("Atmosphere") or child:IsA("ColorCorrectionEffect") then
                            if child.Name ~= "BoxtenFogRemoved" then
                                child.Name = "BoxtenFogRemoved"
                                child.Enabled = false
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("NoFog")
            pcall(function()
                for _, child in ipairs(Lighting:GetChildren()) do
                    if child.Name == "BoxtenFogRemoved" then
                        child.Enabled = true
                    end
                end
            end)
        end
    end
})

local BWEffect = nil
MapSection:Toggle({
    Name = "B&W Filter",
    Default = false,
    Callback = function(v)
        if v then
            if not BWEffect then
                BWEffect = Instance.new("ColorCorrectionEffect")
                BWEffect.Name = "BoxtenBW"
                BWEffect.Saturation = -1
                BWEffect.Contrast = 0.1
                BWEffect.Parent = Lighting
            end
        else
            if BWEffect then
                pcall(function() BWEffect:Destroy() end)
                BWEffect = nil
            end
        end
    end
})

MapSection:Toggle({
    Name = "Remove Particles",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("NoParticles")
            Tracked.Connections["NoParticles"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("ParticleEmitter") then
                            d.Enabled = false
                        elseif d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                            d.Enabled = false
                        end
                    end
                end)
            end)
        else
            safeDisconnect("NoParticles")
            pcall(function()
                local room = getCurrentRoom()
                if not room then return end
                for _, d in ipairs(room:GetDescendants()) do
                    if d:IsA("ParticleEmitter") or d:IsA("Fire")
                    or d:IsA("Smoke") or d:IsA("Sparkles") then
                        d.Enabled = true
                    end
                end
            end)
        end
    end
})

