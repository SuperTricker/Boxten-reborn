            if hum then
                hum.UseJumpPower = true
                hum.JumpPower = v
            end
        end)
    end
})

LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.2)
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = State.LoopSpeed
            hum.UseJumpPower = true
            hum.JumpPower = State.JumpPower
        end
    end)
end)

CharSection:Toggle({
    Name = "Anti-AFK",
    Default = true,
    Callback = function(v)
        State.AntiAfk = v
        if v then
            if not Tracked.Connections["AntiAFK"] then
                Tracked.Connections["AntiAFK"] = LocalPlayer.Idled:Connect(function()
                    if not State.AntiAfk then return end
                    pcall(function()
                        local vu = game:GetService("VirtualUser")
                        vu:CaptureController()
                        vu:ClickButton2(Vector2.new())
                    end)
                end)
            end
        else
            safeDisconnect("AntiAFK")
        end
    end
})

--[[
    BOXTEN REBORN [ULTIMATE] - BLOK 2 / 5
    PAGE 2: Visuals & ESP (Monster, Cooldowns, Machines, Items, NPC, Fullbright, Filters)
]]

local VisualsPage    = Window:Page({Name = "Visuals", Icon = "123944728972740"})
local MonsterSection = VisualsPage:Section({Name = "Monster ESP", Side = 1})
local MapSection     = VisualsPage:Section({Name = "Map ESP", Side = 2})

MonsterSection:Toggle({
    Name = "ESP Twisteds",
    Default = false,
    Callback = function(v)
        State.ESP_Monsters = v
        if v then
            safeDisconnect("ESP_Monsters")
            Tracked.Connections["ESP_Monsters"] = RunService.Heartbeat:Connect(function()
                if not State.ESP_Monsters then return end
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local seen = {}
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                seen[d] = true
                                if not d:FindFirstChild("BoxtenMonsterESP") then
                                    local h = Instance.new("Highlight")
                                    h.Name = "BoxtenMonsterESP"
                                    h.FillColor           = Color3.fromRGB(168, 200, 150)
                                    h.OutlineColor        = Color3.fromRGB(120, 155, 105)
                                    h.FillTransparency    = 0.35
                                    h.OutlineTransparency = 0
                                    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                                    h.Adornee             = d
                                    h.Parent              = d
                                    Tracked.Highlights[d] = h
                                end
                            end
                        end
                    end
                    for m, h in pairs(Tracked.Highlights) do
                        if h.Name == "BoxtenMonsterESP" then
                            if not m.Parent or not h.Parent or not seen[m] then
                                pcall(function() h:Destroy() end)
                                Tracked.Highlights[m] = nil
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("ESP_Monsters")
            destroyHighlights("BoxtenMonsterESP")
        end
    end
})

MonsterSection:Toggle({
    Name = "Show Twisted Ability Counters",
    Default = false,
    Callback = function(v)
        State.ESP_Cooldowns = v
        if v then
            safeDisconnect("ESP_Cooldowns")
            Tracked.Connections["ESP_Cooldowns"] = RunService.Heartbeat:Connect(function()
                if not State.ESP_Cooldowns then return end
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local watch = {
                        ["Goob"]=true,["Astro"]=true,["Gigi"]=true,["Vee"]=true,
                        ["Scraps"]=true,["Pebble"]=true,["Shelly"]=true,["Sprout"]=true,
                        ["Cosmo"]=true,["Tisha"]=true,["Bassie"]=true,["Boxten"]=true,
                        ["Poppy"]=true,["Brightney"]=true,["Teagan"]=true,["Finn"]=true,
                        ["Razzle"]=true,["Dazzle"]=true,["Rodger"]=true,["Glisten"]=true,
                        ["Flutter"]=true,
                    }
                    for _, m in ipairs(room:GetDescendants()) do
                        if m:IsA("Model") and watch[m.Name] then
                            local head = getHead(m)
                            if not head then continue end
                            local bg = head:FindFirstChild("BoxtenCD_BG")
                            if not bg then
                                bg = makeBillboard(head, "BoxtenCD_BG",
                                    UDim2.new(0, 180, 0, 36),
                                    Vector3.new(0, 2.6, 0),
                                    Color3.fromRGB(255, 255, 255))
                            end
                            local function probe(inst)
                                if not inst then return nil end
                                for _, attr in ipairs({"Cooldown","AbilityCooldown","AbilityTime","CD","StunTime"}) do
                                    local ok, val = pcall(function() return inst:GetAttribute(attr) end)
                                    if ok and val ~= nil then return tostring(val) end
                                end
                                for _, c in ipairs(inst:GetChildren()) do
                                    if c:IsA("NumberValue") then
                                        local lower = string.lower(c.Name)
                                        if lower:find("cool") or lower:find("ability") or lower:find("stun") then
                                            return tostring(c.Value)
                                        end
                                    end
                                end
                                return nil
                            end
                            local cd = probe(m)
                                or (m:FindFirstChild("Config") and probe(m.Config))
                                or "READY"
                            local lbl = bg:FindFirstChild("Label")
                            if lbl then
                                lbl.Text = m.Name .. "  •  " .. cd
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("ESP_Cooldowns")
            destroyBillboards("BoxtenCD_BG")
        end
    end
})

MonsterSection:Toggle({
    Name = "Monster Distance ESP",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("MonsterDist")
            Tracked.Connections["MonsterDist"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local head = getHead(d)
                                local hrp = d:FindFirstChild("HumanoidRootPart") or head
                                if head and hrp then
                                    local dist = (hrp.Position - myHRP.Position).Magnitude
                                    local bg = head:FindFirstChild("BoxtenMonsterDist_BG")
                                    if not bg then
                                        bg = makeBillboard(head, "BoxtenMonsterDist_BG",
                                            UDim2.new(0, 140, 0, 24),
                                            Vector3.new(0, 3.4, 0),
                                            Color3.fromRGB(255, 100, 100))
                                    end
                                    local lbl = bg:FindFirstChild("Label")
                                    if lbl then
                                        lbl.Text = math.floor(dist) .. " studs"
                                    end
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("MonsterDist")
            destroyBillboards("BoxtenMonsterDist_BG")
        end
    end
})

MonsterSection:Toggle({
    Name = "Show Monster Names",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("MonsterNames")
            Tracked.Connections["MonsterNames"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local head = getHead(d)
                                if head and not head:FindFirstChild("BoxtenMonsterName_BG") then
                                    local bg = makeBillboard(head, "BoxtenMonsterName_BG",
                                        UDim2.new(0, 140, 0, 26),
                                        Vector3.new(0, 4.2, 0),
                                        Color3.fromRGB(168, 200, 150))
                                    local lbl = bg:FindFirstChild("Label")
                                    if lbl then lbl.Text = d.Name end
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("MonsterNames")
            destroyBillboards("BoxtenMonsterName_BG")
        end
    end
})

local BoxGui = Instance.new("ScreenGui")
BoxGui.Name = "BoxtenBoxESP"
BoxGui.ResetOnSpawn = false
BoxGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
BoxGui.Parent = PlayerGui

local BoxFolder = Instance.new("Folder")
BoxFolder.Name = "Boxes"
BoxFolder.Parent = BoxGui

MonsterSection:Toggle({
    Name = "Box ESP",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("BoxESP")
            Tracked.Connections["BoxESP"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    if not cam then return end
                    local room = getCurrentRoom()
                    if not room then return end
                    local seen = {}
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp then
                                    seen[d.Name] = true
                                    local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                                    if onScreen then
                                        local box = BoxFolder:FindFirstChild(d.Name .. "_box")
                                        if not box then
                                            box = Instance.new("Frame")
                                            box.Name = d.Name .. "_box"
                                            box.BackgroundTransparency = 1
                                            box.BorderSizePixel = 0
                                            box.Parent = BoxFolder
                                            for _, side in ipairs({"Top","Bottom","Left","Right"}) do
                                                local line = Instance.new("Frame")
                                                line.Name = side
                                                line.BackgroundColor3 = Color3.fromRGB(168, 200, 150)
                                                line.BorderSizePixel = 0
                                                line.Parent = box
                                            end
                                        end
                                        local size = 60
                                        box.Size = UDim2.new(0, size, 0, size * 1.5)
                                        box.Position = UDim2.new(0, pos.X - size/2, 0, pos.Y - size*0.75)
                                        box.Top.Size = UDim2.new(1, 0, 0, 2)
                                        box.Top.Position = UDim2.new(0, 0, 0, 0)
                                        box.Bottom.Size = UDim2.new(1, 0, 0, 2)
                                        box.Bottom.Position = UDim2.new(0, 0, 1, -2)
                                        box.Left.Size = UDim2.new(0, 2, 1, 0)
                                        box.Left.Position = UDim2.new(0, 0, 0, 0)
                                        box.Right.Size = UDim2.new(0, 2, 1, 0)
                                        box.Right.Position = UDim2.new(1, -2, 0, 0)
                                    end
                                end
                            end
                        end
                    end
                    for _, c in ipairs(BoxFolder:GetChildren()) do
                        local name = c.Name:gsub("_box", "")
                        if not seen[name] then c:Destroy() end
                    end
                end)
            end)
        else
            safeDisconnect("BoxESP")
            for _, c in ipairs(BoxFolder:GetChildren()) do
                pcall(function() c:Destroy() end)
            end
        end
    end
})

local DangerGui = Instance.new("ScreenGui")
DangerGui.Name = "BoxtenDanger"
DangerGui.ResetOnSpawn = false
DangerGui.IgnoreGuiInset = true
DangerGui.Parent = PlayerGui

local DangerBorder = Instance.new("Frame")
DangerBorder.Name = "Border"
DangerBorder.Size = UDim2.new(1, 0, 1, 0)
DangerBorder.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
DangerBorder.BackgroundTransparency = 1
DangerBorder.BorderSizePixel = 0
DangerBorder.Parent = DangerGui

local dangerStroke = Instance.new("UIStroke")
dangerStroke.Thickness = 20
dangerStroke.Color = Color3.fromRGB(255, 0, 0)
dangerStroke.Transparency = 1
dangerStroke.Parent = DangerBorder

MonsterSection:Toggle({
    Name = "Danger Indicator",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("Danger")
            Tracked.Connections["Danger"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end
                    local nearestDist = math.huge
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp then
                                    local dist = (hrp.Position - myHRP.Position).Magnitude
                                    if dist < nearestDist then nearestDist = dist end
                                end
                            end
                        end
                    end
                    if nearestDist < 30 then
                        dangerStroke.Transparency = 0.2
                    elseif nearestDist < 60 then
                        dangerStroke.Transparency = 0.6
                    else
                        dangerStroke.Transparency = 1
                    end
                end)
            end)
        else
            safeDisconnect("Danger")
            dangerStroke.Transparency = 1
        end
    end
})

MapSection:Toggle({
    Name = "ESP Machines",
    Default = false,
    Callback = function(v)
        State.ESP_Machines = v
        if v then
            safeDisconnect("ESP_Machines")
            Tracked.Connections["ESP_Machines"] = RunService.Heartbeat:Connect(function()
                if not State.ESP_Machines then return end
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("generator") or nm:find("machine") then
                                if not d:FindFirstChild("BoxtenMachineESP") then
                                    local h = Instance.new("Highlight")
                                    h.Name = "BoxtenMachineESP"
                                    h.FillColor           = Color3.fromRGB(0, 255, 0)
                                    h.OutlineColor        = Color3.fromRGB(255, 255, 255)
                                    h.FillTransparency    = 0.4
                                    h.OutlineTransparency = 0
                                    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                                    h.Adornee             = d
                                    h.Parent              = d
                                    Tracked.Highlights[d] = h
                                end
                                local head = getHead(d)
                                if head then
                                    local bg = head:FindFirstChild("BoxtenMachine_BG")
                                    if not bg then
                                        bg = makeBillboard(head, "BoxtenMachine_BG",
                                            UDim2.new(0, 150, 0, 30),
                                            Vector3.new(0, 2.2, 0),
                                            Color3.fromRGB(0, 255, 0))
                                    end
                                    local function probeProg(inst)
                                        if not inst then return nil end
                                        local ok, attr = pcall(function() return inst:GetAttribute("Progress") end)
                                        if ok and attr then return attr end
                                        for _, c in ipairs(inst:GetChildren()) do
                                            if c:IsA("NumberValue") then
                                                local l = string.lower(c.Name)
                                                if l:find("progress") or l:find("percent") or l:find("value") then
                                                    return c.Value
                                                end
                                            end
                                        end
                                        return nil
                                    end
                                    local prog = probeProg(d)
                                        or (d:FindFirstChild("Config") and probeProg(d.Config))
                                        or 0
                                    local lbl = bg:FindFirstChild("Label")
                                    if lbl then
                                        lbl.Text = tostring(math.floor(prog)) .. "%"
                                    end
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("ESP_Machines")
            destroyHighlights("BoxtenMachineESP")
            destroyBillboards("BoxtenMachine_BG")
        end
    end
})

