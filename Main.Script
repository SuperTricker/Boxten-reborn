local TeamPage     = Window:Page({Name = "Team Support", Icon = "100050851789190"})
local TeamSection  = TeamPage:Section({Name = "Teammates ESP", Side = 1})
local TrackSection = TeamPage:Section({Name = "Tracking", Side = 2})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: ESP Players
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
TeamSection:Toggle({
    Name = "ESP Players",
    Default = false,
    Callback = function(v)
        State.ESP_Players = v
        if v then
            safeDisconnect("ESP_Players")
            Tracked.Connections["ESP_Players"] = RunService.Heartbeat:Connect(function()
                if not State.ESP_Players then return end
                pcall(function()
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            if not plr.Character:FindFirstChild("BoxtenPlayerESP") then
                                local h = Instance.new("Highlight")
                                h.Name = "BoxtenPlayerESP"
                                h.FillColor           = Color3.fromRGB(0, 0, 255)
                                h.OutlineColor        = Color3.fromRGB(255, 255, 255)
                                h.FillTransparency    = 0.4
                                h.OutlineTransparency = 0
                                h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                                h.Adornee             = plr.Character
                                h.Parent              = plr.Character
                                Tracked.Highlights[plr.Character] = h
                            end
                        end
                    end

                    for char, h in pairs(Tracked.Highlights) do
                        if h.Name == "BoxtenPlayerESP" and (not char.Parent or not h.Parent) then
                            pcall(function() h:Destroy() end)
                            Tracked.Highlights[char] = nil
                        end
                    end
                end)
            end)
        else
            safeDisconnect("ESP_Players")
            destroyHighlights("BoxtenPlayerESP")
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Show Team Stats
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
TeamSection:Toggle({
    Name = "Show Team Stats",
    Default = false,
    Callback = function(v)
        State.TeamStats = v
        if v then
            safeDisconnect("TeamStats")
            Tracked.Connections["TeamStats"] = RunService.Heartbeat:Connect(function()
                if not State.TeamStats then return end
                pcall(function()
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local head = plr.Character:FindFirstChild("Head")
                            if head then
                                local bg = head:FindFirstChild("BoxtenTeam_BG")
                                if not bg then
                                    bg = makeBillboard(head, "BoxtenTeam_BG",
                                        UDim2.new(0, 220, 0, 42),
                                        Vector3.new(0, 2.9, 0),
                                        Color3.fromRGB(220, 235, 255))
                                end

                                local itemName = "None"
                                local stamina = "?"
                                local hearts = "?"
                                local tool = plr.Character:FindFirstChildOfClass("Tool")
                                if tool then itemName = tool.Name end

                                local cfg = plr.Character:FindFirstChild("Config")
                                if cfg then
                                    if cfg:FindFirstChild("Stamina") then
                                        stamina = tostring(math.floor(cfg.Stamina.Value))
                                    end
                                    if cfg:FindFirstChild("Hearts") then
                                        hearts = tostring(math.floor(cfg.Hearts.Value))
                                    end
                                end

                                local lbl = bg:FindFirstChild("Label")
                                if lbl then
                                    lbl.Text = plr.Name
                                        .. " | " .. itemName
                                        .. " | STA " .. stamina
                                        .. " | HP " .. hearts
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("TeamStats")
            destroyBillboards("BoxtenTeam_BG")
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Show Player Distance
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
TeamSection:Toggle({
    Name = "Show Player Distance",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("PlayerDist")
            Tracked.Connections["PlayerDist"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local head = plr.Character:FindFirstChild("Head")
                            local hrp  = plr.Character:FindFirstChild("HumanoidRootPart")
                            if head and hrp then
                                local dist = (hrp.Position - myHRP.Position).Magnitude
                                local bg = head:FindFirstChild("BoxtenDist_BG")
                                if not bg then
                                    bg = makeBillboard(head, "BoxtenDist_BG",
                                        UDim2.new(0, 140, 0, 24),
                                        Vector3.new(0, 3.6, 0),
                                        Color3.fromRGB(200, 200, 200))
                                end
                                local lbl = bg:FindFirstChild("Label")
                                if lbl then
                                    lbl.Text = math.floor(dist) .. " studs"
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("PlayerDist")
            destroyBillboards("BoxtenDist_BG")
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Player Tracers (lines to teammates)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
local TracerFolder = Instance.new("Folder")
TracerFolder.Name = "BoxtenTracers"
TracerFolder.Parent = PlayerGui

TeamSection:Toggle({
    Name = "Player Tracers",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("Tracers")
            Tracked.Connections["Tracers"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    if not cam then return end

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                                if onScreen then
                                    local tracer = TracerFolder:FindFirstChild(plr.Name .. "_tracer")
                                    if not tracer then
                                        tracer = Instance.new("Frame")
                                        tracer.Name = plr.Name .. "_tracer"
                                        tracer.BackgroundColor3 = Color3.fromRGB(0, 0, 255)
                                        tracer.BorderSizePixel = 0
                                        tracer.Size = UDim2.new(0, 2, 0, 0)
                                        tracer.Parent = TracerFolder
                                    end
                                    tracer.Position = UDim2.new(0, screenPos.X, 0, 0)
                                    tracer.Size = UDim2.new(0, 2, 0, screenPos.Y)
                                end
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("Tracers")
            for _, c in ipairs(TracerFolder:GetChildren()) do
                pcall(function() c:Destroy() end)
            end
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Teammate Alert (notify if teammate gets hurt)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
TeamSection:Toggle({
    Name = "Teammate Health Alert",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("TeamAlert")
            local lastHealth = {}
            Tracked.Connections["TeamAlert"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                            if hum then
                                local prev = lastHealth[plr] or hum.Health
                                if hum.Health < prev - 5 then
                                    notify("Teammate Hurt", plr.Name .. " took damage!")
                                end
                                lastHealth[plr] = hum.Health
                            end
                        end
                    end
                end)
            end)
        else
            safeDisconnect("TeamAlert")
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Highlight Nearest Monster
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
TrackSection:Toggle({
    Name = "Highlight Nearest Twisted",
    Default = false,
    Callback = function(v)
        if v then
            safeDisconnect("NearestMonster")
            Tracked.Connections["NearestMonster"] = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local myChar = LocalPlayer.Character
                    if not myChar then return end
                    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                    if not myHRP then return end

                    local nearest, nearestDist = nil, math.huge
                    for _, d in ipairs(room:GetDescendants()) do
                        if d:IsA("Model") then
                            local nm = string.lower(d.Name)
                            if nm:find("monster") or nm:find("mob") or nm:find("twisted") then
                                local hrp = d:FindFirstChild("HumanoidRootPart") or d:FindFirstChildWhichIsA("BasePart")
                                if hrp then
                                    local dist = (hrp.Position - myHRP.Position).Magnitude
                                    if dist < nearestDist then
                                        nearestDist = dist
                                        nearest = d
                                    end
                                end
                            end
                        end
                    end

                    -- clear old
                    for inst, h in pairs(Tracked.Highlights) do
                        if h.Name == "BoxtenNearest" then
                            if inst ~= nearest then
                                pcall(function() h:Destroy() end)
                                Tracked.Highlights[inst] = nil
                            end
                        end
                    end

                    if nearest and not nearest:FindFirstChild("BoxtenNearest") then
                        local h = Instance.new("Highlight")
                        h.Name = "BoxtenNearest"
                        h.FillColor           = Color3.fromRGB(255, 0, 0)
                        h.OutlineColor        = Color3.fromRGB(255, 255, 255)
                        h.FillTransparency    = 0.3
                        h.OutlineTransparency = 0
                        h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Adornee             = nearest
                        h.Parent              = nearest
                        Tracked.Highlights[nearest] = h
                    end
                end)
            end)
        else
            safeDisconnect("NearestMonster")
            destroyHighlights("BoxtenNearest")
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Player List HUD
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
local PlayerListGui = Instance.new("ScreenGui")
PlayerListGui.Name = "BoxtenPlayerList"
PlayerListGui.ResetOnSpawn = false
PlayerListGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
PlayerListGui.Parent = PlayerGui

local PlayerListFrame = Instance.new("Frame")
PlayerListFrame.Name = "Frame"
PlayerListFrame.AnchorPoint = Vector2.new(1, 0)
PlayerListFrame.Position = UDim2.new(1, -12, 0, 12)
PlayerListFrame.Size = UDim2.new(0, 200, 0, 300)
PlayerListFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
PlayerListFrame.BackgroundTransparency = 0.2
PlayerListFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
PlayerListFrame.BorderSizePixel = 1
PlayerListFrame.Visible = false
PlayerListFrame.Parent = PlayerListGui

local PlayerListTitle = Instance.new("TextLabel")
PlayerListTitle.Name = "Title"
PlayerListTitle.Size = UDim2.new(1, 0, 0, 26)
PlayerListTitle.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
PlayerListTitle.BackgroundTransparency = 0.2
PlayerListTitle.BorderSizePixel = 0
PlayerListTitle.Text = "PLAYERS"
PlayerListTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
PlayerListTitle.Font = Enum.Font.GothamBold
PlayerListTitle.TextSize = 14
PlayerListTitle.Parent = PlayerListFrame

local PlayerListContainer = Instance.new("ScrollingFrame")
PlayerListContainer.Name = "Container"
PlayerListContainer.Position = UDim2.new(0, 0, 0, 28)
PlayerListContainer.Size = UDim2.new(1, 0, 1, -28)
PlayerListContainer.BackgroundTransparency = 1
PlayerListContainer.BorderSizePixel = 0
PlayerListContainer.ScrollBarThickness = 3
PlayerListContainer.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
PlayerListContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
PlayerListContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y
PlayerListContainer.Parent = PlayerListFrame

local function rebuildPlayerList()
    pcall(function()
        for _, c in ipairs(PlayerListContainer:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() end
        end
        local y = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            local lbl = Instance.new("TextLabel")
            lbl.Name = plr.Name
            lbl.Size = UDim2.new(1, -4, 0, 22)
            lbl.Position = UDim2.new(0, 2, 0, y)
            lbl.BackgroundTransparency = 1
            lbl.Text = plr.Name .. (plr == LocalPlayer and " (You)" or "")
            lbl.TextColor3 = (plr == LocalPlayer) and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(230, 230, 230)
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.Parent = PlayerListContainer
            y = y + 22
        end
        PlayerListContainer.CanvasSize = UDim2.new(0, 0, 0, y)
    end)
end

TrackSection:Toggle({
    Name = "Player List HUD",
    Default = false,
    Callback = function(v)
        PlayerListFrame.Visible = v
        if v then
            rebuildPlayerList()
            safeDisconnect("PlayerListUpdates")
            Tracked.Connections["PlayerListUpdates"] = Players.PlayerAdded:Connect(rebuildPlayerList)
            Players.PlayerRemoving:Connect(rebuildPlayerList)
        else
            safeDisconnect("PlayerListUpdates")
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Server Hop (uses TeleportService ��� NOT a remote exploit)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
TrackSection:Button({
    Name = "Server Hop",
    Callback = function()
        pcall(function()
            local TeleportService = game:GetService("TeleportService")
            local HttpService = game:GetService("HttpService")
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            local ok, res = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)
            if ok and res and res.data then
                for _, server in ipairs(res.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        end)
                        return
                    end
                end
            end
            notify("Server Hop", "No servers found")
        end)
    end
})

