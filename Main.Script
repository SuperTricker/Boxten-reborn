--=============================================================================
-- [10] FUN & SKINS
--=============================================================================

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Become Dandy (Skin Changer)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Button({
    Name = "Become Dandy (Skin Changer)",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then
                notify("Become Dandy", "No character")
                return
            end
            local head = char:FindFirstChild("Head")
            if not head then
                notify("Become Dandy", "No head")
                return
            end

            -- Remove CHAir
            local chair = char:FindFirstChild("CHAIR") or head:FindFirstChild("CHAIR")
            if chair then chair:Destroy() end

            -- Remove previous DHAir if exists
            local oldHair = head:FindFirstChild("DHAir")
            if oldHair then oldHair:Destroy() end

            -- Clone DHAir from DandyShop
            local shop = Workspace:FindFirstChild("DandyShop")
                or (Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("DandyShop", true))
            local dHair = shop and shop:FindFirstChild("DHAir", true)
            if dHair then
                local clone = dHair:Clone()
                clone.Name = "DHAir"
                clone.Parent = head
                if clone:IsA("BasePart") then
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = head
                    weld.Part1 = clone
                    weld.Parent = clone
                elseif clone:IsA("Model") then
                    for _, p in ipairs(clone:GetDescendants()) do
                        if p:IsA("BasePart") then
                            local weld = Instance.new("WeldConstraint")
                            weld.Part0 = head
                            weld.Part1 = p
                            weld.Parent = p
                        end
                    end
                end
            end

            -- Re-texture face
            local face = head:FindFirstChildOfClass("Decal")
            if face then
                if face:FindFirstChild("NormalTexture") then
                    face.NormalTexture.Texture = "rbxassetid://16496414911"
                else
                    face.Texture = "rbxassetid://16496414911"
                end
                if face:FindFirstChild("HurtTexture") then
                    face.HurtTexture.Texture = "rbxassetid://17561468145"
                end
            end

            -- Update AnimationIds
            local animate = char:FindFirstChild("Animate")
            if animate then
                local idle = animate:FindFirstChild("idle")
                if idle and idle:FindFirstChild("Animation1") then
                    idle.Animation1.AnimationId = "rbxassetid://16496520991"
                end
                local run = animate:FindFirstChild("run")
                if run and run:FindFirstChild("RunAnim") then
                    run.RunAnim.AnimationId = "rbxassetid://16496812530"
                end
            end

            notify("Become Dandy", "Applied")
        end)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Reset Skin (restore)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Button({
    Name = "Reset Skin",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local head = char:FindFirstChild("Head")
            if not head then return end
            local hair = head:FindFirstChild("DHAir")
            if hair then hair:Destroy() end
            notify("Reset Skin", "DHAir removed")
        end)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Funny Twisted Faces (Mesh Morpher)
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
FunSection:Button({
    Name = "Funny Twisted Faces (Mesh Morpher)",
    Callback = function()
        State.FunnyFaces = not State.FunnyFaces
        if not State.FunnyFaces then
            notify("Funny Faces", "Disabled")
            return
        end
        notify("Funny Faces", "Enabled")

        task.spawn(function()
            while State.FunnyFaces do
                pcall(function()
                    local room = getCurrentRoom()
                    if not room then return end
                    local monsters = room:FindFirstChild("Monsters")
                    if not monsters then return end

                    for _, m in ipairs(monsters:GetChildren()) do
                        if m:IsA("Model") then
                            local head = m:FindFirstChild("Head")
                            if head then
                                local mesh = head:FindFirstChildOfClass("SpecialMesh")
                                if not mesh then
                                    mesh = Instance.new("SpecialMesh")
                                    mesh.Parent = head
                                end
                                mesh.MeshId = "rbxassetid://16496393049"
                                mesh.Scale = Vector3.new(1, 1, 1)
                            end
                        end
                    end
                end)
                task.wait(20)
            end
        end)
    end
})

