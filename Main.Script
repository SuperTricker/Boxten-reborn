local MiscPage     = Window:Page({Name = "Miscellaneous", Icon = "122669828593160"})
local LobbySection = MiscPage:Section({Name = "Lobby Exploits", Side = 1})
local FunSection   = MiscPage:Section({Name = "Fun & Skins", Side = 2})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Remove Dev Door
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
LobbySection:Button({
    Name = "Remove Dev Door (Lobby)",
    Callback = function()
        local removed = 0
        for _, name in ipairs({"DevDoor", "DevDoor2", "DevDoor3", "DevBarrier"}) do
            local d = Workspace:FindFirstChild(name)
            if d then
                pcall(function() d:Destroy() end)
                removed = removed + 1
            end
            local lobby = Workspace:FindFirstChild("Lobby")
            if lobby then
                local d2 = lobby:FindFirstChild(name, true)
                if d2 then
                    pcall(function() d2:Destroy() end)
                    removed = removed + 1
                end
            end
        end
        notify("Dev Door", "Removed: " .. removed)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Instant Dandy Store Quick-Buy
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
LobbySection:Button({
    Name = "Instant Dandy Store Quick-Buy",
    Callback = function()
        local count = 0
        pcall(function()
            local shop = Workspace:FindFirstChild("DandyShop")
                or (Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("DandyShop", true))
            if not shop then
                notify("Quick-Buy", "DandyShop not found")
                return
            end
            for _, d in ipairs(shop:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    d.MaxActivationDistance = 9999
                    d.HoldDuration = 0
                    d.RequiresLineOfSight = false
                    safeFire(d)
                    count = count + 1
                end
            end
        end)
        notify("Quick-Buy", "Prompts fired: " .. count)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- TOGGLE: Auto-Buy Loop
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
LobbySection:Toggle({
    Name = "Auto-Buy Loop",
    Default = false,
    Callback = function(v)
        State.AutoBuy = v
        if v then
            task.spawn(function()
                while State.AutoBuy do
                    task.wait(0.5)
                    pcall(function()
                        local shop = Workspace:FindFirstChild("DandyShop")
                        if not shop then return end
                        for _, d in ipairs(shop:GetDescendants()) do
                            if d:IsA("ProximityPrompt") then
                                d.MaxActivationDistance = 9999
                                d.HoldDuration = 0
                                d.RequiresLineOfSight = false
                                safeFire(d)
                            end
                        end
                    end)
                end
            end)
        end
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Teleport to Lobby
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
LobbySection:Button({
    Name = "Teleport to Lobby",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local lobby = Workspace:FindFirstChild("Lobby")
            if lobby then
                local part = lobby:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                end
            end
        end)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Teleport to Nearest Generator
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
LobbySection:Button({
    Name = "Teleport to Nearest Generator",
    Callback = function()
        pcall(function()
            local room = getCurrentRoom()
            if not room then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local nearest, nearestDist = nil, math.huge
            for _, d in ipairs(room:GetDescendants()) do
                if d:IsA("Model") then
                    local nm = string.lower(d.Name)
                    if nm:find("generator") or nm:find("machine") then
                        local part = d:FindFirstChildWhichIsA("BasePart")
                        if part then
                            local dist = (part.Position - hrp.Position).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearest = part
                            end
                        end
                    end
                end
            end

            if nearest then
                hrp.CFrame = nearest.CFrame + Vector3.new(0, 5, 0)
                notify("Teleport", "Moved to generator (" .. math.floor(nearestDist) .. " studs)")
            else
                notify("Teleport", "No generator found")
            end
        end)
    end
})

--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
-- BUTTON: Teleport to Nearest Item
--���������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������
LobbySection:Button({
    Name = "Teleport to Nearest Item",
    Callback = function()
        pcall(function()
            local room = getCurrentRoom()
            if not room then return end
            local items = room:FindFirstChild("Items")
            if not items then
                notify("Teleport", "No items folder")
                return
            end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local nearest, nearestDist = nil, math.huge
            for _, d in ipairs(items:GetDescendants()) do
                if d:IsA("Model") or d:IsA("BasePart") then
                    local part = d:IsA("BasePart") and d or d:FindFirstChildWhichIsA("BasePart")
                    if part then
                        local dist = (part.Position - hrp.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearest = part
                        end
                    end
                end
            end

            if nearest then
                hrp.CFrame = nearest.CFrame + Vector3.new(0, 5, 0)
                notify("Teleport", "Moved to item (" .. math.floor(nearestDist) .. " studs)")
            else
                notify("Teleport", "No item found")
            end
        end)
    end
})

