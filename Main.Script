        Callback = function()
            State.ESP_Monsters = not State.ESP_Monsters
        end
    })
    KeybindList:Add({
        Name = "Toggle Fly",
        Key = Enum.KeyCode.F,
        Callback = function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local bv = hrp:FindFirstChild("BoxtenFly")
            if bv then
                bv:Destroy()
                local bg = hrp:FindFirstChild("BoxtenFlyGyro")
                if bg then bg:Destroy() end
            else
                local bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.Name = "BoxtenFly"
                bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                bodyVelocity.Velocity = Vector3.zero
                bodyVelocity.Parent = hrp
                local bodyGyro = Instance.new("BodyGyro")
                bodyGyro.Name = "BoxtenFlyGyro"
                bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                bodyGyro.P = 3000
                bodyGyro.Parent = hrp
            end
        end
    })
end)

--=============================================================================
-- [12] CLEANUP ON CLOSE
--=============================================================================
pcall(function()
    if Library and Library.OnClose then
        local oldClose = Library.OnClose
        Library.OnClose = function()
            pcall(function() oldClose() end)
            State.AutoCalibration  = false
            State.MachineAura      = false
            State.InfiniteStamina  = false
            State.Noclip           = false
            State.GodMode          = false
            State.ESP_Monsters     = false
            State.ESP_Cooldowns    = false
            State.ESP_Machines     = false
            State.ESP_Items        = false
            State.ESP_LobbyItems   = false
            State.ESP_NPC          = false
            State.Fullbright       = false
            State.ESP_Players      = false
            State.TeamStats        = false
            State.FunnyFaces       = false
            State.Lobotomy         = false
            State.AutoBuy          = false
            State.AutoDialogue     = false
            State.AntiAfk          = false

            safeDisconnectAll()

            for _, h in pairs(Tracked.Highlights) do
                pcall(function() h:Destroy() end)
            end
            Tracked.Highlights = {}

            for b in pairs(Tracked.Billboards) do
                pcall(function() b:Destroy() end)
            end
            Tracked.Billboards = {}

            if FullbrightBackup then
                pcall(function()
                    Lighting.Ambient        = FullbrightBackup.Ambient
                    Lighting.OutdoorAmbient = FullbrightBackup.OutdoorAmbient
                    Lighting.FogEnd         = FullbrightBackup.FogEnd
                    Lighting.FogStart       = FullbrightBackup.FogStart
                    Lighting.GlobalShadows  = FullbrightBackup.GlobalShadows
                    Lighting.Brightness     = FullbrightBackup.Brightness
                    Lighting.ClockTime      = FullbrightBackup.ClockTime
                    Lighting.EnvironmentDiffuseScale  = FullbrightBackup.EnvironmentDiffuseScale
                    Lighting.EnvironmentSpecularScale = FullbrightBackup.EnvironmentSpecularScale
                end)
                FullbrightBackup = nil
            end

            pcall(function()
                if BWEffect then BWEffect:Destroy() end
            end)

            pcall(function()
                if PlayerListGui then PlayerListGui:Destroy() end
            end)

            pcall(function()
                if TracerFolder then TracerFolder:Destroy() end
            end)
        end
    end
end)

